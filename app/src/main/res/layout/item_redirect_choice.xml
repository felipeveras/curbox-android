<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:minHeight="72dp" android:gravity="center_vertical" android:paddingVertical="12dp"
    android:orientation="horizontal">
    <ImageView android:id="@+id/redirect_choice_icon" android:layout_width="40dp"
        android:layout_height="40dp" android:importantForAccessibility="no"
        android:layout_marginEnd="16dp" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/redirect_choice_name" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Material3.BodyLarge" />
        <TextView android:id="@+id/redirect_choice_package" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Material3.BodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" android:breakStrategy="simple" />
    </LinearLayout>
    <RadioButton android:id="@+id/redirect_choice_checked" android:layout_width="48dp"
        android:layout_height="48dp" android:clickable="false" android:focusable="false"
        android:importantForAccessibility="no" />
</LinearLayout>
