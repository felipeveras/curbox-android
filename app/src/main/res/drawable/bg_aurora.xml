<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><color android:color="?android:attr/colorBackground" /></item>
    <item>
        <shape>
            <gradient
                android:centerX="0.85"
                android:centerY="0.0"
                android:endColor="@android:color/transparent"
                android:gradientRadius="420dp"
                android:startColor="@color/aurora_blue"
                android:type="radial" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:centerX="0.0"
                android:centerY="1.0"
                android:endColor="@android:color/transparent"
                android:gradientRadius="360dp"
                android:startColor="@color/aurora_indigo"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
